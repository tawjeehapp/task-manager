# Prod Supabase project — copy to .env.prod and fill in values.
# Activate with: make use-prod
# Never set ALLOW_DEV_SEED=true. Never run `make seed` against prod.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Database password (Settings → Database) — used by `make use-prod` for CLI link
SUPABASE_DB_PASSWORD=

# Push notifications (foundation only — unused until later milestones)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Feature flags — default off; set to "true" or "1" to enable
NEXT_PUBLIC_FEATURE_GANTT=false
NEXT_PUBLIC_FEATURE_KANBAN=false
